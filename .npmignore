# .npmignore - The Firewall
# Strictly block Python source and dev assets from the NPM package

src/
tests/python/
scripts/
pyproject.toml
requirements.txt
MANIFEST.in
*.py
*.pyc
__pycache__/
.venv/
.git/
.github/

# Runtime audit logs & testing cache
**/sovereign_audit.log
**/audit_logs/
*.log
.pytest_cache/
