{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:odgs:schema:rule",
    "title": "ODGS Standard Data Rule",
    "description": "Schema for validating individual rule definitions in the Judiciary plane. v6.0.0 adds SOFT_STOP severity, dependency chains, and rule versioning.",
    "type": "object",
    "required": [
        "rule_id",
        "name"
    ],
    "properties": {
        "rule_id": {
            "type": "string"
        },
        "urn": {
            "type": "string",
            "pattern": "^urn:odgs:rule:"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "definition": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "domain": {
            "type": "string"
        },
        "businessRule": {
            "type": "string"
        },
        "severity": {
            "type": "string",
            "enum": [
                "HARD_STOP",
                "SOFT_STOP",
                "WARNING",
                "INFO"
            ],
            "description": "HARD_STOP: unconditional halt. SOFT_STOP: halt unless override token provided. WARNING: logged, non-blocking. INFO: informational only."
        },
        "logic_expression": {
            "type": "string"
        },
        "calculation_logic": {
            "type": "string"
        },
        "requires_human_review": {
            "type": "boolean"
        },
        "depends_on": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^urn:odgs:rule:"
            },
            "description": "List of rule URNs that must pass before this rule is evaluated. Forms a directed acyclic graph (DAG) for evaluation ordering."
        },
        "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Semantic version of the rule definition (e.g. '1.0.0'). Tracked in S-Cert audit logs for provenance."
        },
        "effective_from": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date from which this rule becomes active."
        },
        "effective_to": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date after which this rule is no longer active."
        },
        "icon": {
            "type": "string"
        },
        "owner": {
            "type": "string"
        },
        "exampleGood": {
            "type": "string"
        },
        "examplePoor": {
            "type": "string"
        },
        "targetIndustries": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "improvesDqDimensionIds": {
            "type": "array",
            "items": {
                "type": [
                    "string",
                    "integer"
                ]
            }
        },
        "semantic_hash": {
            "type": "string",
            "description": "SHA-256 hash of the rule's legislative provenance for drift detection."
        },
        "metadata": {
            "type": "object"
        }
    },
    "additionalProperties": false
}