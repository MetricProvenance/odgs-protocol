{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://odgs.org/schemas/factors.schema.json",
    "title": "ODGS Root Cause Factors",
    "description": "Schema for ODGS Root Cause Factors",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "factorId": {
                "type": "string"
            },
            "factorName": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "typicalSymptomsInOrg": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "dqDimensionsImpactedIds": {
                "type": "array",
                "items": {
                    "type": "integer"
                },
                "description": "Referenced dimensionId entries from standard_dq_dimensions.json (ISO/IEC 25012 & ISO 8000-8)"
            },
            "remediationControls": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Governance and operational remediation controls (ISO/IEC 38505-1:2026)"
            },
            "regulatoryAlignment": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Regulations aligned with this factor (e.g., EU AI Act, DORA, CSRD)"
            }
        },
        "required": [
            "factorId",
            "factorName",
            "description"
        ]
    }
}