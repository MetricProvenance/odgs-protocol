{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://odgs.org/schemas/process.schema.json",
    "title": "ODGS Business Process Maps",
    "description": "Schema for ODGS Business Process Maps",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "lifecycleId": {
                "type": "string"
            },
            "lifecycleName": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "typicalIndustries": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "keyStakeholders": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "stages": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "stageId": {
                            "type": "string"
                        },
                        "stageName": {
                            "type": "string"
                        },
                        "description": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "stageId",
                        "stageName"
                    ]
                }
            }
        },
        "required": [
            "lifecycleId",
            "lifecycleName",
            "stages"
        ]
    }
}